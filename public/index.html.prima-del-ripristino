        }
        async function ajJoin(code) { await ajOpenBoard(await ajApi('/api/boards/join',{method:'POST',body:JSON.stringify({roomCode:code})})); }
        async function ajReady() {
            ajMe=await ajApi('/api/me'); document.getElementById('ajLogin').classList.add('aj-hidden'); document.getElementById('ajLobby').classList.remove('aj-hidden'); ajSocket.connect();
            const room=new URLSearchParams(location.search).get('room'); if(room){document.getElementById('joinCode').value=room; await ajJoin(room);}
        }
        (async()=>{const cfg=await ajApi('/api/config');if(cfg.devAuth)document.getElementById('devLogin').classList.remove('aj-hidden');if(cfg.googleClientId){google.accounts.id.initialize({client_id:cfg.googleClientId,callback:async x=>{await ajApi('/api/auth/google',{method:'POST',body:JSON.stringify({credential:x.credential})});ajReady()}});google.accounts.id.renderButton(document.getElementById('googleBtn'),{theme:'outline',size:'large'})}try{await ajReady()}catch{}})();
        document.getElementById('devBtn').onclick=async()=>{await ajApi('/api/auth/dev',{method:'POST',body:JSON.stringify({name:document.getElementById('devName').value,email:document.getElementById('devEmail').value})});ajReady()};
        document.getElementById('newBtn').onclick=async()=>ajOpenBoard(await ajApi('/api/boards',{method:'POST',body:'{}'}));
        document.getElementById('joinBtn').onclick=()=>ajJoin(document.getElementById('joinCode').value);
        document.getElementById('ajRequestEdit').onclick=async()=>{await ajApi(`/api/boards/${ajBoard.id}/request-edit`,{method:'POST',body:'{}'});document.getElementById('ajRequestEdit').textContent='Richiesta inviata';document.getElementById('ajRequestEdit').disabled=true};
        ajSocket.on('board:operation', ajApplyOperation); ajSocket.on('board:reload', ajReload);
        ajSocket.on('access:requested', async request=>{if(confirm(`${request.name} (${request.email}) desidera modificare il Jotter. Autorizzare?`))await ajApi(`/api/access/${request.requestId}/resolve`,{method:'POST',body:JSON.stringify({approved:true})});else await ajApi(`/api/access/${request.requestId}/resolve`,{method:'POST',body:JSON.stringify({approved:false})})});
        ajSocket.on('access:resolved', result=>{if(result.boardId===ajBoard?.id){ajSetRole(result.role);alert(result.approved?'Accesso in modifica autorizzato.':'Richiesta rifiutata.')}});
    </script>
</body>
</html>