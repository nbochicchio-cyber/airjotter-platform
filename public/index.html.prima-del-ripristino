        function finalizeStamp(mode) {
            const rect = stampContainer.getBoundingClientRect();
            const wRect = wrapper.getBoundingClientRect();
            const logX = (rect.left - wRect.left) * (LOGICAL_W / wRect.width);
            const logY = (rect.top - wRect.top) * (LOGICAL_H / wRect.height);
            const logW = rect.width * (LOGICAL_W / wRect.width);
            const logH = rect.height * (LOGICAL_H / wRect.height);
            
            expandCanvasIfNeeded(logY + logH);

            let stampCopy = document.createElement('canvas');
            stampCopy.width = stampCanvas.width; stampCopy.height = stampCanvas.height;
            stampCopy.getContext('2d').drawImage(stampCanvas, 0, 0);
            
            commands.push({ type: 'stamp', canvas: stampCopy, x: logX, y: logY, w: logW, h: logH, mode: mode });
            redoCommands = []; redrawMainCanvas();
            document.getElementById('undoBtn').disabled = false;
            
            resetStampUI();
        }

