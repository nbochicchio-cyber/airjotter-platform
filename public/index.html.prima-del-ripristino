                    let tempC = document.createElement('canvas'); tempC.width = sw; tempC.height = sh;
                    tempC.getContext('2d').drawImage(stampCanvas, sx, sy, sw, sh, 0, 0, sw, sh);
                    
                    stampCanvas.width = sw; stampCanvas.height = sh;
                    stampCtx.clearRect(0,0,sw,sh); stampCtx.drawImage(tempC, 0, 0);
                    
                    stampContainer.style.width = cw + 'px'; stampContainer.style.height = ch + 'px';
