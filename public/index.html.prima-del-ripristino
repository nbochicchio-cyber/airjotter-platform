<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>airjotter.com</title>
    
    <!-- External Libraries -->
    <script src="/socket.io/socket.io.js"></script>
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';</script>
<style>
        :root {
            --bg-color: #EFE9E1;
            --paper-color: #FFFFFF;
            --ui-bg: rgba(255, 253, 249, 0.94);
            --text-color: #3D3A50;
            --text-soft: #7A7590;
            --accent-color: #8FA9E0;
            --accent-hover: #7593D2;
            --accent-bg: #EEF3FC;
            --border-color: #EBE4DA;
            --border-soft: #F4EFE6;
            --danger-color: #D88579;
            --danger-bg: #FBEDEA;
            --success-color: #7DBA95;
            --success-bg: #EDF6EF;
            --warning-color: #E9C97C;
            --warning-bg: #FBF3DE;
            --shadow-soft: 0 2px 12px rgba(80, 60, 100, 0.06);
            --shadow-medium: 0 6px 24px rgba(80, 60, 100, 0.10);
            --shadow-strong: 0 12px 40px rgba(80, 60, 100, 0.16);
            --border-radius: 14px;
        
            --a4-w: 800px;
            --a4-h: 1131px;
            --total-pages: 2;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; -webkit-tap-highlight-color: transparent; }
        body, html { width: 100%; min-height: 100vh; background-color: var(--bg-color); color: var(--text-color); overflow-x: hidden; }

        header {
            position: fixed; top: 12px; left: 50%; transform: translateX(-50%); transform-origin: top center;
            width: max-content; max-width: none; background: var(--ui-bg); border: 1px solid var(--border-color);
            border-radius: var(--border-radius); box-shadow: var(--shadow-medium);
            backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
            z-index: 100; display: flex; align-items: center; justify-content: flex-start;
            padding: 8px 12px; gap: 8px; white-space: nowrap;
        }

        .brand { display:flex; align-items:center; flex-shrink:0; cursor:pointer; transition:transform 0.1s;}
        .brand:active { transform: scale(0.95); }
        .brand-logo { width:142px; height:32px; object-fit:contain; display:block; }

        .tools-group { display: flex; align-items: center; gap: 6px; padding: 0 8px; border-right: 1px solid var(--border-color); flex-shrink: 0; }
        .tools-group:last-child { border-right: none; padding-right: 0; }

        .tool-color { width: 26px; height: 26px; border: none; border-radius: 50%; cursor: pointer; padding: 0; background: none; flex-shrink: 0; }
        .tool-color::-webkit-color-swatch-wrapper { padding: 0; }
        .tool-color::-webkit-color-swatch { border: 2px solid var(--border-color); border-radius: 50%; box-shadow: var(--shadow-soft); }
        .tool-thickness { width: 60px; cursor: pointer; accent-color: var(--accent-color); height: 4px; }

        .icon-btn { background: transparent; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; color: var(--text-color); opacity: 0.75; transition: all 0.15s ease; padding: 6px; border-radius: 8px; flex-shrink: 0; min-width: 30px; min-height: 30px; }
        .icon-btn:hover:not(:disabled) { opacity: 1; background: var(--accent-bg); color: var(--accent-hover); }
        .icon-btn:disabled { opacity: 0.25; cursor: not-allowed; }
        .icon-btn svg { width: 16px; height: 16px; stroke-width: 2; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; }

        .btn { display: flex; align-items: center; gap: 4px; background: var(--border-soft); color: var(--text-color); border: 1px solid transparent; padding: 6px 12px; border-radius: 10px; font-weight: 600; font-size: 0.8rem; cursor: pointer; transition: transform 0.1s, background 0.2s, border-color 0.2s; flex-shrink: 0; }
        .btn:hover { background: #FFFFFF; border-color: var(--border-color); }
        .btn:active { transform: scale(0.96); }
        .btn svg { width: 14px; height: 14px; stroke-width: 2; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; }
        
        .btn.primary { background: var(--accent-color); color: white; border-color: var(--accent-color); }
        .btn.primary:hover { background: var(--accent-hover); border-color: var(--accent-hover); }
        .btn.danger { color: var(--danger-color); background: var(--danger-bg); }
        .btn.danger:hover { background: #F7DFDA; }
        .btn.success { color: var(--success-color); background: var(--success-bg); }
        .btn.success:hover { background: #DFEEE3; }

        .active-tool { background: var(--accent-bg); color: var(--accent-hover); box-shadow: inset 0 0 0 1px var(--accent-color); }
        .room-code { font-family: ui-monospace, SFMono-Regular, monospace; font-size: 0.9rem; font-weight: 700; letter-spacing: 2px; background: var(--accent-bg); color: var(--text-color); padding: 5px 10px; border-radius: 7px; }

        #canvas-wrapper { position: relative; width: var(--a4-w); height: calc(var(--a4-h) * var(--total-pages)); margin: 90px auto 60px auto; background-color: var(--paper-color); box-shadow: var(--shadow-strong); background-image: linear-gradient(to bottom, transparent 0, transparent 39px, rgba(140, 130, 170, 0.05) 40px); background-size: 100% 40px; overflow: hidden; touch-action: none; }
        #drawingBoard, #draftBoard { display: block; position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
        #drawingBoard { z-index: 2; pointer-events: none; }
        #draftBoard { z-index: 3; cursor: crosshair; touch-action: none; pointer-events: auto; }

        .real-page-break { position: absolute; left: 0; width: 100%; height: 3px; background-color: var(--bg-color); border-top: 1px dashed var(--accent-color); border-bottom: 1px solid var(--border-color); z-index: 4; pointer-events: none; }
        .real-page-break::after { content: attr(data-page-label); position: absolute; top: -20px; right: 10px; background: var(--bg-color); color: var(--text-soft); padding: 2px 8px; border-radius: 4px; border: 1px solid var(--border-color); font-size: 11px; font-weight: 600; }

        .page-count-display { display: inline-flex; align-items: center; gap: 4px; font-size: 0.85rem; font-weight: 700; color: var(--text-color); background: var(--border-soft); padding: 5px 10px; border-radius: 8px; min-width: 42px; justify-content: center; }
        .page-btn { width: 30px; height: 30px; border-radius: 8px; background: var(--border-soft); border: 1px solid transparent; color: var(--text-color); font-size: 1.1rem; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.15s ease; flex-shrink: 0; padding: 0; }
        .page-btn:hover:not(:disabled) { background: var(--accent-bg); color: var(--accent-hover); border-color: var(--accent-color); }

        .page-delete-btn { position: absolute; right: 20px; width: 36px; height: 36px; background: var(--danger-bg); color: var(--danger-color); border: 1px solid var(--danger-color); border-radius: 10px; cursor: pointer; z-index: 5; display: flex; align-items: center; justify-content: center; opacity: 0.6; transition: all 0.2s; box-shadow: var(--shadow-soft); pointer-events: auto; }
        .page-delete-btn:hover { opacity: 1; transform: scale(1.05); background: #F7DFDA; }

        #stamp-panel { position: fixed; top: 80px; right: 20px; background: var(--ui-bg); border: 1px solid var(--border-color); border-radius: var(--border-radius); padding: 18px; box-shadow: var(--shadow-strong); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); z-index: 200; display: none; flex-direction: column; gap: 12px; width: 290px; }
        .stamp-control-group { display: flex; flex-direction: column; gap: 6px; }
        .stamp-control-label { font-size: 0.72rem; font-weight: 700; color: var(--text-soft); text-transform: uppercase; letter-spacing: 0.6px; }
        .stamp-btn { padding: 11px 14px; border: 1px solid transparent; border-radius: 10px; font-weight: 600; font-size: 0.87rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; transition: background 0.2s, transform 0.1s; }
        .stamp-btn:active { transform: scale(0.98); }
        .stamp-btn.cancel { background: var(--danger-bg); color: var(--danger-color); margin-top: 8px; }
        .stamp-btn.fit { background: var(--accent-bg); color: var(--accent-hover); border-color: var(--accent-color); margin-bottom: 6px; }
        .stamp-btn.apply-under { background: var(--success-bg); color: var(--success-color); border-color: var(--success-color); }
        .stamp-btn.apply-over { background: var(--success-color); color: white; }

        #stamp-container { position: absolute; display: none; z-index: 150; border: 2px dashed var(--accent-color); background: rgba(143, 169, 224, 0.04); cursor: move; touch-action: none; }
        #stamp-canvas { width: 100%; height: 100%; pointer-events: none; display: block; }
        #crop-overlay { display: none; position: absolute; border: 2px dashed red; background: rgba(255, 0, 0, 0.15); pointer-events: none; z-index: 10; }
        .resize-handle { position: absolute; bottom: -14px; right: -14px; width: 30px; height: 30px; background: white; border: 2px solid var(--accent-color); border-radius: 50%; cursor: nwse-resize; display: flex; align-items: center; justify-content: center; color: var(--accent-color); box-shadow: var(--shadow-medium); }
        .resize-handle svg { width: 14px; height: 14px; }

        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(60, 50, 80, 0.35); backdrop-filter: blur(6px); z-index: 300; align-items: center; justify-content: center; padding: 20px; }
        .modal-content { background: white; padding: 28px; border-radius: 18px; text-align: center; max-width: 320px; width: 100%; box-shadow: var(--shadow-strong); }
        input[type="file"] { display: none; }

        #text-tool-overlay { position: absolute; display: none; z-index: 250; border: 2px dashed var(--accent-color); padding: 5px; background: rgba(255,255,255,0.8); border-radius: 8px; flex-direction: column; gap: 5px; box-shadow: var(--shadow-strong); }
        #text-tool-input { background: transparent; border: 1px dashed var(--border-color); outline: none; resize: both; font-family: 'Inter', sans-serif; font-size: 12px; color: var(--text-color); min-width: 200px; min-height: 40px; padding: 5px; overflow: hidden; }
        .text-toolbar { display: flex; gap: 5px; background: var(--ui-bg); padding: 5px; border-radius: 6px; border: 1px solid var(--border-color); cursor: move; touch-action: none; align-items: center;}
        .text-toolbar select, .text-toolbar button.fmt-btn { border: 1px solid var(--border-color); border-radius: 4px; padding: 4px; background: white; cursor: pointer; font-size: 14px;}
        .text-toolbar button.fmt-btn.active { background: var(--accent-bg); color: var(--accent-hover); border-color: var(--accent-color); font-weight: bold;}
        
        .pdf-page-wrapper { display: flex; flex-direction: column; align-items: center; gap: 8px; flex-shrink: 0; border: 1px solid var(--border-color); padding: 12px; border-radius: 10px; background: #fafafa; position: relative; transition: transform 0.2s; }
        .pdf-page-wrapper img { height: 320px; width: auto; border: 1px solid #ddd; box-shadow: var(--shadow-soft); background: white; }
        .page-controls { display: flex; gap: 5px; width: 100%; justify-content: center; }
        .page-controls button { padding: 4px 8px; border-radius: 4px; border: 1px solid #ccc; background: white; cursor: pointer; font-size: 14px; }
        .page-controls button:hover:not(:disabled) { background: #eee; }
        .page-controls button:disabled { opacity: 0.3; cursor: not-allowed; }
        .page-controls button.del-btn { color: var(--danger-color); border-color: var(--danger-color); }
        .page-controls button.del-btn:hover { background: var(--danger-bg); }
        .page-number-badge { position: absolute; top: 16px; left: 16px; background: rgba(0,0,0,0.6); color: white; padding: 2px 6px; border-radius: 4px; font-size: 12px; font-weight: bold; }

        @media (max-width: 768px) { #stamp-panel { top: auto; bottom: 20px; right: 50%; transform: translateX(50%); width: 90%; max-width: 350px; } }
    
        .aj-overlay { position:fixed; inset:0; z-index:1000; background:rgba(239,233,225,.96); display:flex; align-items:center; justify-content:center; padding:20px; }
        .aj-card { background:white; width:min(520px,100%); padding:28px; border-radius:18px; box-shadow:var(--shadow-strong); text-align:center; }
        .aj-card input { padding:10px 12px; border:1px solid var(--border-color); border-radius:9px; margin:4px; }
        .aj-hidden { display:none !important; }
        .aj-user { font-size:.75rem; color:var(--text-soft); white-space:nowrap; }
        .aj-request { background:var(--warning-bg); color:var(--text-color); }
</style>
</head>
<body>
    <div id="ajLogin" class="aj-overlay"><div class="aj-card"><img src="airjotter_logo.png" alt="airjotter.com" style="width:230px"><h2>Accedi</h2><div id="googleBtn"></div><div id="devLogin" class="aj-hidden"><p>Accesso sviluppo</p><input id="devName" value="Utente Demo"><input id="devEmail" value="demo1@local.test"><button id="devBtn" class="btn primary">Entra</button></div></div></div>
    <div id="ajLobby" class="aj-overlay aj-hidden"><div class="aj-card"><img src="airjotter_logo.png" alt="airjotter.com" style="width:230px"><h2>Avvia o apri un Jotter</h2><button id="newBtn" class="btn primary" style="margin:auto">Crea sessione casuale</button><p style="margin:16px">oppure</p><input id="joinCode" maxlength="9" placeholder="ABCD-EFGH"><button id="joinBtn" class="btn">Apri con codice</button></div></div>

    <header>
        <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
            <div class="brand" title="Torna in cima" id="brandBtn"><img class="brand-logo" src="airjotter_logo.png" alt="airjotter.com"></div>
            <button id="helpBtn" style="background:var(--accent-bg); color:var(--accent-color); border:1px solid var(--accent-color); border-radius:50%; width:22px; height:22px; display:flex; align-items:center; justify-content:center; font-weight:bold; font-size:12px; cursor:pointer;" title="Guida all'uso">?</button>
        </div>
        
        <div class="tools-group">
            <button id="toolPenBtn" class="icon-btn active-tool" title="Penna"><svg viewBox="0 0 24 24"><path d="M12 19l7-7 3 3-7 7-3-3z"></path><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path><path d="M2 2l7.586 7.586"></path><circle cx="11" cy="11" r="2"></circle></svg></button>
            <button id="toolEraserBtn" class="icon-btn" title="Gomma"><svg viewBox="0 0 24 24"><path d="M20 20H7L3 16C2.5 15.5 2.5 14.5 3 14L13 4C13.5 3.5 14.5 3.5 15 4L20 9C20.5 9.5 20.5 10.5 20 11L11 20H20V20Z"></path><path d="M17 6L11 12"></path></svg></button>
            <button id="toolTextBtn" class="icon-btn" title="Testo"><svg viewBox="0 0 24 24"><polyline points="4 7 4 4 20 4 20 7"></polyline><line x1="9" y1="20" x2="15" y2="20"></line><line x1="12" y1="4" x2="12" y2="20"></line></svg></button>
            <input type="color" id="colorPicker" class="tool-color" value="#1D1D1F" title="Colore tratto">
            <input type="range" id="thicknessPicker" class="tool-thickness" min="0.5" max="12.5" step="0.5" value="2.5" title="Spessore tratto">
        </div>

        <div class="tools-group">
            <button id="undoBtn" class="icon-btn" title="Annulla" disabled><svg viewBox="0 0 24 24"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 00-9-9 9 9 0 00-6 2.3L3 13"/></svg></button>
            <button id="redoBtn" class="icon-btn" title="Ripeti" disabled><svg viewBox="0 0 24 24"><path d="M21 7v6h-6"/><path d="M3 17a9 9 0 019-9 9 9 0 016 2.3l3 2.7"/></svg></button>
        </div>

        <div class="tools-group">
            <button id="importPdfBtn" class="btn" style="padding: 4px 8px;">
                <svg viewBox="0 0 24 24" style="margin-right:2px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg> 
                <span>PDF</span>
            </button>
            <button id="importSignBtn" class="btn"><svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg> Firma</button>
            <button id="importRealImgBtn" class="btn success"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg> Foto</button>
            
            <input type="file" id="fileInputSign" accept="image/png, image/jpeg, image/jpg">
            <input type="file" id="fileInputRealImg" accept="image/png, image/jpeg, image/jpg">
            <input type="file" id="fileInputPdf" accept="application/pdf">
        </div>

        <div class="tools-group">
            <span id="ajUser" class="aj-user"></span><button id="ajRequestEdit" class="btn aj-request aj-hidden">Richiedi modifica</button><span id="roomCode" class="room-code">***-***</span>
            <button id="toggleCodeBtn" class="icon-btn" title="Mostra Codice"><svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
            <button id="showQrBtn" class="icon-btn" title="QR Code"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 14h1v1h-1z"/><path d="M17 17h1v1h-1z"/><path d="M14 17h1v1h-1z"/><path d="M17 14h1v1h-1z"/></svg></button>
        </div>

        <div class="tools-group">
            <button id="removePageBtn" class="page-btn" title="Rimuovi ultima pagina">−</button>
            <span id="pageCountDisplay" class="page-count-display">
                <span id="pageCountNumber">2</span>
            </span>
            <button id="addPageBtn" class="page-btn" title="Aggiungi pagina">+</button>
        </div>

        <div class="tools-group">
            <button id="clearBtn" class="btn danger" title="Pulisci Foglio"><svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>
            <button id="exportPdfBtn" class="btn primary">Esporta PDF</button>
        </div>
    </header>

    <div id="canvas-wrapper">
        <canvas id="drawingBoard"></canvas>
        <canvas id="draftBoard"></canvas>
        
        <div id="stamp-container">
            <canvas id="stamp-canvas"></canvas>
            <div id="crop-overlay"></div>
            <div class="resize-handle" id="stamp-resize">
                <svg viewBox="0 0 24 24"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" y1="3" x2="14" y2="10"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg>
            </div>
        </div>
        
        <div id="text-tool-overlay">
            <div class="text-toolbar" id="text-drag-handle">
                <select id="text-font-family">
                    <option value="Arial, sans-serif">Arial</option>
                    <option value="'Times New Roman', serif">Times</option>
                </select>
                <select id="text-font-size">
                    <option value="8">8</option>
                    <option value="9">9</option>
                    <option value="10">10</option>
                    <option value="11">11</option>
                    <option value="12" selected>12</option>
                    <option value="14">14</option>
                    <option value="16">16</option>
                    <option value="18">18</option>
                    <option value="20">20</option>
                    <option value="22">22</option>
                    <option value="24">24</option>
                    <option value="26">26</option>
                    <option value="28">28</option>
                    <option value="36">36</option>
                    <option value="48">48</option>
                    <option value="72">72</option>
                </select>
                <button class="fmt-btn" id="btn-bold">B</button>
                <button class="fmt-btn" id="btn-italic" style="font-style: italic;">I</button>
                <button class="fmt-btn" id="btn-underline" style="text-decoration: underline;">U</button>
                <div style="flex-grow: 1;"></div>
                <button class="icon-btn" id="textConfirmBtn" style="color:var(--success-color);" title="Conferma Testo"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg></button>
                <button class="icon-btn" id="textCancelBtn" style="color:var(--danger-color);" title="Annulla Testo"><svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
            </div>
            <textarea id="text-tool-input" placeholder="Scrivi qui..."></textarea>
        </div>
    </div>

    <div id="stamp-panel">
        <div id="image-controls">
            <div class="stamp-control-group" style="flex-direction: row; align-items: center; justify-content: space-between;">
                <div style="flex: 1; padding-right: 15px;">
                    <span class="stamp-control-label">Sfondo Firma</span>
                    <input type="range" id="stampTransparency" class="tool-thickness" min="0" max="100" value="100" style="width:100%">
                </div>
                <div style="display: flex; flex-direction: column; align-items: center;">
                    <span class="stamp-control-label">Colore</span>
                    <input type="color" id="stampColor" class="tool-color" value="#1D1D1F">
                </div>
            </div>
        </div>
        
        <button class="stamp-btn" id="stampCropBtn" style="border: 1px solid var(--border-color);">✂️ Ritaglia</button>
        <button class="stamp-btn fit" id="stampFitA4">📄 Adatta a pagina</button>
        <button class="stamp-btn apply-over" id="stampOver">👆 Applica Sopra</button>
        <button class="stamp-btn apply-under" id="stampUnder">👇 Applica Sotto</button>
        <button class="stamp-btn cancel" id="stampCancel">✕ Annulla</button>
    </div>

    <!-- Help Modal -->
