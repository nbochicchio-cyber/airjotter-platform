        function hexToRgb(hex) { const res = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex); return res ? { r: parseInt(res[1], 16), g: parseInt(res[2], 16), b: parseInt(res[3], 16) } : { r: 0, g: 0, b: 0 }; }
        
        function applyChromaKeyToStamp() {
            if (!rawImageObj || currentStampType !== 'signature') return;
            stampCanvas.width = rawImageObj.width; stampCanvas.height = rawImageObj.height;
            stampCtx.drawImage(rawImageObj, 0, 0);
            
            const imageData = stampCtx.getImageData(0, 0, rawImageObj.width, rawImageObj.height);
            const data = imageData.data;
            const color = hexToRgb(document.getElementById('stampColor').value);
            const tLevel = document.getElementById('stampTransparency').value / 100;
            
            for (let i = 0; i < data.length; i += 4) {
                let r = data[i], g = data[i+1], b = data[i+2], a = data[i+3];
                if (a === 0) continue;
                let nLum = (r * 0.299 + g * 0.587 + b * 0.114) / 255, eAlpha = 0;
                if (nLum <= 0.6) eAlpha = Math.pow(1 - (nLum / 0.6), 0.5) * 255; 
                let fAlpha = a * (1 - tLevel) + eAlpha * tLevel;
                data[i+3] = Math.max(0, Math.min(255, fAlpha));
                if (fAlpha > 0 && tLevel > 0) { data[i] = color.r; data[i+1] = color.g; data[i+2] = color.b; }
            }
            stampCtx.putImageData(imageData, 0, 0);
        }

        document.getElementById('stampTransparency').addEventListener('input', applyChromaKeyToStamp);
        document.getElementById('stampColor').addEventListener('input', applyChromaKeyToStamp);

