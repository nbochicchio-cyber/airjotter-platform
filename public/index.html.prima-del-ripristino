        }
        async function ajSend(type, payload) {
            if (!ajBoard || ajRemote || !ajCanWrite()) return;
            const operationId = crypto.randomUUID();
            return ajSocket.emitWithAck('board:operation', { boardId: ajBoard.id, operationId, type, payload });
        }
        function ajSerializableCommand(cmd) {
            if (!cmd || !['path','text'].includes(cmd.type)) return null;
            return JSON.parse(JSON.stringify(cmd, (key, value) => key === 'renderIndex' ? undefined : value));
        }
        function ajSendCommand(cmd) { const clean = ajSerializableCommand(cmd); if (clean) ajSend('command:add', { command: clean }); }
        function ajSendPageCount() { ajSend('page:set', { count: TOTAL_PAGES }); }
        function ajSendClear() { ajSend('board:clear', {}); }
        function ajApplyOperation(op) {
            const type = op.operation_type || op.type, payload = op.payload || {};
            ajRemote = true;
            if (type === 'command:add' && payload.command) commands.push(payload.command);
            else if (type === 'stroke:add') commands.push({ type:'path', points:payload.points, color:payload.color, isEraser:!!payload.eraser });
            else if (type === 'text:add') commands.push({ type:'text', text:payload.text, x:payload.x, y:payload.y, fontFamily:'Arial, sans-serif', fontSize:payload.size || 24, color:payload.color, isBold:false, isItalic:false, isUnderline:false });
            else if (type === 'page:set') { TOTAL_PAGES = Math.max(1, payload.count); initCanvas(); }
            else if (type === 'board:clear') { commands=[]; redoCommands=[]; TOTAL_PAGES=2; initCanvas(); }
            redrawMainCanvas();
            document.getElementById('undoBtn').disabled = commands.length === 0;
            ajRemote = false;
        }
        async function ajReload() {
            if (!ajBoard) return;
            commands=[]; redoCommands=[]; TOTAL_PAGES=2;
            const operations = await ajApi(`/api/boards/${ajBoard.id}/operations`);
            operations.filter(x => x.is_active !== false).forEach(ajApplyOperation);
            initCanvas(); redrawMainCanvas();
