    <script>
        let ACTUAL_ROOM_CODE = "";
        let TOTAL_PAGES = 2; 
        
        let commands = [];
        let redoCommands = [];
        let isDrawing = false;
        let baseWidth = 2.5;
        let currentColor = '#1D1D1F';
        let currentPath = null;
        let dpr = 1;
        
        const LOGICAL_W = 900;
        const BASE_A4_H = 1273; 
        let LOGICAL_H = BASE_A4_H * TOTAL_PAGES;

        let activePointers = new Map();
        let initialScrollX = 0, initialScrollY = 0, panStartCenter = null;

        let lastEventData = null; 
        let pointerVelocity = 0; 

        let currentMode = 'pen'; 
        let textOverlayActive = false;

        let stampActive = false, currentStampType = null, rawImageObj = null;
        let isDragging = false, isResizing = false, isCroppingMode = false, isDrawingCrop = false;
        let startX, startY, startLeft, startTop, startWidth, startHeight, cropStartX, cropStartY;
        
        let exportPagesData = [];
        
        const wrapper = document.getElementById('canvas-wrapper');
        const mainCanvas = document.getElementById('drawingBoard');
        const mainCtx = mainCanvas.getContext('2d', { alpha: true }); 
        const draftCanvas = document.getElementById('draftBoard');
        const draftCtx = draftCanvas.getContext('2d');
        
        const colorPicker = document.getElementById('colorPicker');
        const thicknessPicker = document.getElementById('thicknessPicker');
        
        const stampContainer = document.getElementById('stamp-container');
        const stampCanvas = document.getElementById('stamp-canvas');
        const stampCtx = stampCanvas.getContext('2d', { willReadFrequently: true });
        const stampPanel = document.getElementById('stamp-panel');
        const resizeHandle = document.getElementById('stamp-resize');
        const cropOverlay = document.getElementById('crop-overlay');

        function initCanvas() {
            LOGICAL_H = BASE_A4_H * TOTAL_PAGES;

            const MAX_CANVAS_AREA = 16000000;
            const MAX_CANVAS_DIM = 16000;
            let preferredDpr = Math.max(window.devicePixelRatio || 1, 2);

            if ((LOGICAL_W * preferredDpr) * (LOGICAL_H * preferredDpr) > MAX_CANVAS_AREA) {
                preferredDpr = Math.sqrt(MAX_CANVAS_AREA / (LOGICAL_W * LOGICAL_H));
            }
            if (LOGICAL_H * preferredDpr > MAX_CANVAS_DIM) preferredDpr = MAX_CANVAS_DIM / LOGICAL_H;
            
            dpr = preferredDpr > 0.2 ? preferredDpr : 0.2;

            document.documentElement.style.setProperty('--a4-w', LOGICAL_W + 'px');
            document.documentElement.style.setProperty('--a4-h', BASE_A4_H + 'px');
            document.documentElement.style.setProperty('--total-pages', TOTAL_PAGES);

            mainCanvas.width = LOGICAL_W * dpr; mainCanvas.height = LOGICAL_H * dpr; 
            mainCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
            
            draftCanvas.width = LOGICAL_W * dpr; draftCanvas.height = LOGICAL_H * dpr; 
            draftCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

            updateBrush();
            redrawMainCanvas();
            renderVisiblePageBreaks(); 
            handleResize(); 
            
            document.getElementById('pageCountNumber').innerText = TOTAL_PAGES;
        }

        function handleResize() {
            const screenW = document.documentElement.clientWidth;
            const availableW = screenW - 20; 
            let zoom = availableW / LOGICAL_W;
            if (zoom > 1) zoom = 1; 
            
            wrapper.style.transform = `scale(${zoom})`;
            wrapper.style.transformOrigin = 'top center';
            
            const emptySpace = LOGICAL_H * (1 - zoom);
            wrapper.style.marginBottom = `calc(60px - ${emptySpace}px)`;
            
            const header = document.querySelector('header');
            header.style.transform = `translateX(-50%) scale(1)`; 
            
            const contentW = header.offsetWidth;
            const safeW = screenW - 24; 
            
            if (contentW > safeW) {
                const headerZoom = safeW / contentW;
                header.style.transform = `translateX(-50%) scale(${headerZoom})`;
            }
        }
        window.addEventListener('resize', handleResize);

        function deletePageFromCanvas(pageIndex) {
            if (TOTAL_PAGES <= 1) {
                alert("Non puoi eliminare l'unica pagina rimasta.");
                return;
            }
            if (confirm(`Vuoi davvero eliminare la Pagina ${pageIndex + 1}? Il contenuto verrà cancellato e le pagine successive saliranno.`)) {
                const startY = pageIndex * BASE_A4_H;
                const endY = startY + BASE_A4_H;
                
                const newCommands = [];
                commands.forEach(cmd => {
                    if (cmd.type === 'path') {
                        let minY = Infinity, maxY = -Infinity;
                        cmd.points.forEach(p => {
                            if (p.y < minY) minY = p.y;
                            if (p.y > maxY) maxY = p.y;
                        });
                        
                        let centerY = (minY + maxY) / 2;
                        if (centerY >= endY) {
                            // Element is below the deleted page, shift it up
                            const shiftedPoints = cmd.points.map(p => ({...p, y: p.y - BASE_A4_H}));
                            newCommands.push({...cmd, points: shiftedPoints});
                        } else if (centerY < startY) {
                            // Element is above, keep as is
                            newCommands.push(cmd);
                        }
                        // if centered in the deleted page, discard it.
                    } else if (cmd.type === 'stamp' || cmd.type === 'text') {
                        let h = cmd.h || (cmd.fontSize * 1.5 * cmd.text.split('\n').length);
                        let centerY = cmd.y + h / 2;
                        
                        if (centerY >= endY) {
                            newCommands.push({...cmd, y: cmd.y - BASE_A4_H});
                        } else if (centerY < startY) {
                            newCommands.push(cmd);
                        }
                    }
                });
                
                commands = newCommands;
                TOTAL_PAGES--;
                document.getElementById('pageCountNumber').innerText = TOTAL_PAGES;
                initCanvas(); 
            }
        }

        function renderVisiblePageBreaks() {
            document.querySelectorAll('.real-page-break, .page-delete-btn').forEach(e => e.remove());
            for(let i = 0; i < TOTAL_PAGES; i++) {
                if (i > 0) {
                    let brk = document.createElement('div');
                    brk.className = 'real-page-break';
                    brk.style.top = (i * BASE_A4_H) + 'px';
                    brk.setAttribute('data-page-label', `Pagina ${i + 1}`);
                    wrapper.appendChild(brk);
                }
                
                // Add a trash button to easily delete this specific page
                let delBtn = document.createElement('button');
                delBtn.className = 'page-delete-btn';
                delBtn.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>';
                delBtn.title = `Elimina Pagina ${i + 1}`;
                delBtn.style.top = (i * BASE_A4_H + 20) + 'px';
                delBtn.onclick = () => deletePageFromCanvas(i);
                wrapper.appendChild(delBtn);
            }
        }

        function expandCanvasIfNeeded(yPos) {
            const requiredPages = Math.ceil((yPos + (BASE_A4_H * 0.2)) / BASE_A4_H);
            if (requiredPages > TOTAL_PAGES && TOTAL_PAGES < 100) { 
                TOTAL_PAGES = requiredPages; 
                initCanvas(); 
            }
        }

        const textToolOverlay = document.getElementById('text-tool-overlay');
        const textToolInput = document.getElementById('text-tool-input');
        const textDragHandle = document.getElementById('text-drag-handle');
        
        let isDraggingText = false;
        let textStartX = 0, textStartY = 0, textInitialLeft = 0, textInitialTop = 0;
        let isTextBold = false, isTextItalic = false, isTextUnderline = false;

        const btnBold = document.getElementById('btn-bold');
        const btnItalic = document.getElementById('btn-italic');
        const btnUnderline = document.getElementById('btn-underline');

        function updateTextInputStyle() {
            textToolInput.style.fontWeight = isTextBold ? 'bold' : 'normal';
            textToolInput.style.fontStyle = isTextItalic ? 'italic' : 'normal';
            textToolInput.style.textDecoration = isTextUnderline ? 'underline' : 'none';
            textToolInput.style.fontFamily = document.getElementById('text-font-family').value;
            textToolInput.style.fontSize = document.getElementById('text-font-size').value + 'px';
        }
        
        updateTextInputStyle();

        btnBold.addEventListener('click', () => { isTextBold = !isTextBold; btnBold.classList.toggle('active', isTextBold); updateTextInputStyle(); });
        btnItalic.addEventListener('click', () => { isTextItalic = !isTextItalic; btnItalic.classList.toggle('active', isTextItalic); updateTextInputStyle(); });
        btnUnderline.addEventListener('click', () => { isTextUnderline = !isTextUnderline; btnUnderline.classList.toggle('active', isTextUnderline); updateTextInputStyle(); });
        
        document.getElementById('text-font-family').addEventListener('change', updateTextInputStyle);
        document.getElementById('text-font-size').addEventListener('change', updateTextInputStyle);

        textDragHandle.addEventListener('pointerdown', (e) => {
            isDraggingText = true;
            textStartX = e.clientX;
            textStartY = e.clientY;
            textInitialLeft = parseFloat(textToolOverlay.style.left) || 0;
            textInitialTop = parseFloat(textToolOverlay.style.top) || 0;
            e.stopPropagation();
        });

        document.getElementById('textCancelBtn').addEventListener('click', () => {
            textToolOverlay.style.display = 'none';
            textOverlayActive = false;
        });

        document.getElementById('textConfirmBtn').addEventListener('click', () => {
            const text = textToolInput.value;
            if (text.trim() !== '') {
                // Precise text coordinate calculation avoiding any jumping offsets
                const overlayLeft = parseFloat(textToolOverlay.style.left) || 0;
                const overlayTop = parseFloat(textToolOverlay.style.top) || 0;
                
                // Offset of the textarea within the overlay
                const inputOffsetX = textToolInput.offsetLeft;
                const inputOffsetY = textToolInput.offsetTop;
                
                // Accounts for standard textarea padding (5px) and 1px border inside the scaled container
                const paddingX = 6; 
                const paddingY = 6; 

                const finalLogX = overlayLeft + inputOffsetX + paddingX;
                const finalLogY = overlayTop + inputOffsetY + paddingY;
                
                const fontFamily = document.getElementById('text-font-family').value;
                const fontSize = parseInt(document.getElementById('text-font-size').value);
                
                commands.push({
                    type: 'text',
                    text: text,
                    x: finalLogX,
                    y: finalLogY,
                    fontFamily: fontFamily,
                    fontSize: fontSize,
                    isBold: isTextBold,
                    isItalic: isTextItalic,
                    isUnderline: isTextUnderline,
                    color: currentColor
                });
                
                ajSendCommand(commands[commands.length - 1]);
                redoCommands = [];
                document.getElementById('undoBtn').disabled = false;
                redrawMainCanvas();
                expandCanvasIfNeeded(finalLogY + (fontSize * 2));
            }
            textToolOverlay.style.display = 'none';
            textOverlayActive = false;
        });

        function updateBrush() { 
            baseWidth = parseFloat(thicknessPicker.value); 
            currentColor = colorPicker.value; 
            if (textOverlayActive) {
                textToolInput.style.color = currentColor;
            }
        }
        colorPicker.addEventListener('input', updateBrush);
        thicknessPicker.addEventListener('input', updateBrush);

        function getPointerPos(e) {
            const rect = draftCanvas.getBoundingClientRect();
            return {
                x: (e.clientX - rect.left) * (LOGICAL_W / rect.width),
                y: (e.clientY - rect.top) * (LOGICAL_H / rect.height)
            };
        }

        function renderPathToCtx(context, cmd, isIncremental = false) {
            if (!cmd || cmd.type !== 'path' || cmd.points.length === 0) return;
            
            const isEraser = cmd.isEraser;
            context.globalCompositeOperation = isEraser ? 'destination-out' : 'source-over';
            context.lineCap = 'round';
            context.lineJoin = 'round';

            const pts = cmd.points;
            if (pts.length === 1 && !isIncremental) {
                context.fillStyle = isEraser ? 'rgba(0,0,0,1)' : cmd.color;
                context.beginPath();
                context.arc(pts[0].x, pts[0].y, pts[0].w / 2, 0, Math.PI * 2);
                context.fill();
                context.globalCompositeOperation = 'source-over';
                return;
            }

            context.strokeStyle = isEraser ? 'rgba(0,0,0,1)' : cmd.color;
            let startIndex = isIncremental ? Math.max(1, cmd.renderIndex || 1) : 1;
            
            for (let i = startIndex; i < pts.length; i++) {
                const p0 = i === 1 ? pts[0] : pts[i - 2] || pts[0];
                const p1 = pts[i - 1];
                const p2 = pts[i];
                
                const cp1x = p0.x + (p1.x - p0.x) / 2;
                const cp1y = p0.y + (p1.y - p0.y) / 2;
                
                const cp2x = p1.x + (p2.x - p1.x) / 2;
                const cp2y = p1.y + (p2.y - p1.y) / 2;
                
                context.beginPath();
                context.moveTo(cp1x, cp1y);
                context.quadraticCurveTo(p1.x, p1.y, cp2x, cp2y);
                context.lineWidth = p1.w;
                context.stroke();
            }

            if (isIncremental) cmd.renderIndex = Math.max(1, pts.length - 1);
            context.globalCompositeOperation = 'source-over';
        }

        draftCanvas.addEventListener('pointerdown', e => {
            if(stampActive || textOverlayActive) return; 
            activePointers.set(e.pointerId, e);
            
            if (activePointers.size === 1) {
                if (currentMode === 'text') {
                    const pos = getPointerPos(e);
                    textToolOverlay.style.display = 'flex';
                    textToolOverlay.style.left = pos.x + 'px';
                    textToolOverlay.style.top = pos.y + 'px';
                    textToolInput.value = '';
                    textToolInput.style.width = '200px';
                    textToolInput.style.height = '40px';
                    textToolInput.style.color = currentColor;
                    updateTextInputStyle();
                    
                    setTimeout(() => textToolInput.focus(), 50);
                    textOverlayActive = true;
                    return;
                }
                
                try { draftCanvas.setPointerCapture(e.pointerId); } catch(err){}
                isDrawing = true;
                const pos = getPointerPos(e);
                
                const initP = (e.pointerType === 'pen' && e.pressure > 0) ? e.pressure : 0.5;
                const w = baseWidth * (0.2 + Math.pow(initP, 1.5) * 1.8);

                currentPath = { 
                    type: 'path', 
                    color: currentColor, 
                    points: [{ x: pos.x, y: pos.y, w: w }], 
                    isEraser: currentMode === 'eraser',
                    renderIndex: 1
                };
                
                lastEventData = { clientX: e.clientX, clientY: e.clientY, timeStamp: e.timeStamp };
                pointerVelocity = 0;
                
                const targetCtx = currentMode === 'eraser' ? mainCtx : draftCtx;
                if (currentMode === 'eraser') targetCtx.globalCompositeOperation = 'destination-out';
                targetCtx.fillStyle = currentMode === 'eraser' ? 'rgba(0,0,0,1)' : currentColor;
                targetCtx.beginPath();
                targetCtx.arc(pos.x, pos.y, currentPath.points[0].w / 2, 0, Math.PI * 2);
                targetCtx.fill();
                if (currentMode === 'eraser') targetCtx.globalCompositeOperation = 'source-over';
            } else if (activePointers.size === 2) {
                isDrawing = false; currentPath = null; draftCtx.clearRect(0,0, LOGICAL_W, LOGICAL_H);
                let pts = Array.from(activePointers.values());
                panStartCenter = { x: (pts[0].clientX + pts[1].clientX)/2, y: (pts[0].clientY + pts[1].clientY)/2 };
                initialScrollX = window.scrollX; initialScrollY = window.scrollY;
            }
        });

        draftCanvas.addEventListener('pointermove', e => {
            if (activePointers.has(e.pointerId)) activePointers.set(e.pointerId, e);
            
            if (activePointers.size === 2 && panStartCenter) {
                let pts = Array.from(activePointers.values());
                let center = { x: (pts[0].clientX + pts[1].clientX)/2, y: (pts[0].clientY + pts[1].clientY)/2 };
                window.scrollTo(initialScrollX - (center.x - panStartCenter.x), initialScrollY - (center.y - panStartCenter.y));
                return;
            }
            
            if (isDrawing && activePointers.size === 1) {
                const evs = e.getCoalescedEvents ? e.getCoalescedEvents() : [e];
                let modified = false;
                
                for (const ev of evs) {
                    const pos = getPointerPos(ev);
                    const lastPt = currentPath.points[currentPath.points.length - 1];

                    let targetW = baseWidth;
                    
                    if (ev.pointerType === 'pen' && ev.pressure > 0) {
                        targetW = baseWidth * (0.1 + Math.pow(ev.pressure, 1.5) * 2.2);
                    } else if (lastEventData) {
                        const dx = ev.clientX - lastEventData.clientX;
                        const dy = ev.clientY - lastEventData.clientY;
                        const dt = ev.timeStamp - lastEventData.timeStamp;
                        const vel = Math.hypot(dx, dy) / (dt || 16);
                        
                        pointerVelocity = pointerVelocity * 0.7 + vel * 0.3;
                        const velFactor = Math.min(1, pointerVelocity / 4);
                        targetW = baseWidth * (1.2 - velFactor * 0.8);
                    }
                    lastEventData = { clientX: ev.clientX, clientY: ev.clientY, timeStamp: ev.timeStamp };

                    const coordSmoothing = 0.45; 
                    const widthSmoothing = 0.25; 

                    const sx = lastPt.x + (pos.x - lastPt.x) * (1 - coordSmoothing);
                    const sy = lastPt.y + (pos.y - lastPt.y) * (1 - coordSmoothing);
                    const sw = lastPt.w + (targetW - lastPt.w) * widthSmoothing;

                    const distSq = (sx - lastPt.x)**2 + (sy - lastPt.y)**2;
                    
                    if (distSq > 0.2) { 
                        currentPath.points.push({ x: sx, y: sy, w: sw });
                        expandCanvasIfNeeded(sy);
                        modified = true;
                    }
                }
                
                if (modified) {
                    if (currentMode === 'eraser') renderPathToCtx(mainCtx, currentPath, true); 
                    else renderPathToCtx(draftCtx, currentPath, true);
                }
            }
        });

        function endPointer(e) {
            activePointers.delete(e.pointerId);
            if (isDrawing && activePointers.size === 0) {
                const evs = e.getCoalescedEvents ? e.getCoalescedEvents() : [e];
                for (const ev of evs) {
                    const pos = getPointerPos(ev);
                    const lastPt = currentPath.points[currentPath.points.length - 1];
                    const distSq = (pos.x - lastPt.x)**2 + (pos.y - lastPt.y)**2;
                    if(distSq > 1) { 
                        currentPath.points.push({ x: pos.x, y: pos.y, w: lastPt.w * 0.8 }); 
                    }
                }
                
                if (currentMode !== 'eraser') renderPathToCtx(mainCtx, currentPath, false);
                
                commands.push(currentPath);
                ajSendCommand(currentPath);
                redoCommands = [];
                document.getElementById('undoBtn').disabled = commands.length === 0;

                draftCtx.clearRect(0, 0, LOGICAL_W, LOGICAL_H);
                isDrawing = false; currentPath = null; lastEventData = null;
                try { draftCanvas.releasePointerCapture(e.pointerId); } catch(err){}
            }
        }
        draftCanvas.addEventListener('pointerup', endPointer);
        draftCanvas.addEventListener('pointercancel', endPointer);

        function redrawMainCanvas() {
            mainCtx.clearRect(0, 0, LOGICAL_W, LOGICAL_H);
            for (let cmd of commands) {
                if (cmd.type === 'path') renderPathToCtx(mainCtx, cmd, false);
                else if (cmd.type === 'stamp') {
                    mainCtx.globalCompositeOperation = cmd.mode === 'under' ? 'destination-over' : 'source-over';
                    mainCtx.drawImage(cmd.canvas, cmd.x, cmd.y, cmd.w, cmd.h);
                    mainCtx.globalCompositeOperation = 'source-over';
                }
                else if (cmd.type === 'text') {
                    mainCtx.save();
                    mainCtx.font = `${cmd.isItalic ? 'italic ' : ''}${cmd.isBold ? 'bold ' : ''}${cmd.fontSize}px ${cmd.fontFamily}`;
                    mainCtx.fillStyle = cmd.color;
                    mainCtx.textBaseline = 'top';
                    
                    const lines = cmd.text.split('\n');
                    const lineHeight = cmd.fontSize * 1.2;
                    
                    lines.forEach((line, i) => {
                        mainCtx.fillText(line, cmd.x, cmd.y + (i * lineHeight));
                        if(cmd.isUnderline) {
                            const metrics = mainCtx.measureText(line);
                            mainCtx.beginPath();
                            mainCtx.moveTo(cmd.x, cmd.y + (i * lineHeight) + cmd.fontSize);
                            mainCtx.lineTo(cmd.x + metrics.width, cmd.y + (i * lineHeight) + cmd.fontSize);
                            mainCtx.strokeStyle = cmd.color;
                            mainCtx.lineWidth = Math.max(1, cmd.fontSize / 15);
                            mainCtx.stroke();
                        }
                    });
                    mainCtx.restore();
                }
            }
        }

        window.addEventListener('pointermove', (e) => {
            const rect = wrapper.getBoundingClientRect();
            const scale = rect.width / LOGICAL_W;

            if (isDragging) {
                let newX = startLeft + (e.clientX - startX) / scale;
                let newY = startTop + (e.clientY - startY) / scale;
                if (newY < 0) newY = 0; 
                stampContainer.style.left = newX + 'px'; stampContainer.style.top = newY + 'px';
            } else if (isResizing) {
                const aspectRatio = stampCanvas.width / stampCanvas.height;
                const newWidth = Math.max(80, startWidth + (e.clientX - startX) / scale);
                stampContainer.style.width = newWidth + 'px'; stampContainer.style.height = (newWidth / aspectRatio) + 'px';
            } else if (isDraggingText) {
                let newX = textInitialLeft + (e.clientX - textStartX) / scale;
                let newY = textInitialTop + (e.clientY - textStartY) / scale;
                textToolOverlay.style.left = newX + 'px';
                textToolOverlay.style.top = newY + 'px';
            } else if (isDrawingCrop) {
                const sRect = stampContainer.getBoundingClientRect();
                const scaleX = stampContainer.offsetWidth / sRect.width;
                const scaleY = stampContainer.offsetHeight / sRect.height;
                
                let curX = Math.max(0, Math.min((e.clientX - sRect.left) * scaleX, stampContainer.offsetWidth));
                let curY = Math.max(0, Math.min((e.clientY - sRect.top) * scaleY, stampContainer.offsetHeight));
                
                cropOverlay.style.left = Math.min(cropStartX, curX) + 'px';
                cropOverlay.style.top = Math.min(cropStartY, curY) + 'px';
                cropOverlay.style.width = Math.abs(curX - cropStartX) + 'px';
                cropOverlay.style.height = Math.abs(curY - cropStartY) + 'px';
            }
        });
        
