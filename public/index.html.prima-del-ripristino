            stampContainer.style.width = displayW + 'px'; stampContainer.style.height = displayH + 'px';
            const visibleTopInWrapper = Math.max(0, -wrapper.getBoundingClientRect().top) + 90; 
            
            stampContainer.style.left = ((wrapper.getBoundingClientRect().width - displayW) / 2) + 'px';
            stampContainer.style.top = visibleTopInWrapper + 'px'; 
            
            if (type === 'pdf') { document.getElementById('stampFitA4').style.display = 'block'; document.getElementById('image-controls').style.display = 'none'; } 
            else if (type === 'signature') { document.getElementById('stampFitA4').style.display = 'none'; document.getElementById('image-controls').style.display = 'block'; document.getElementById('stampTransparency').value = 100; } 
